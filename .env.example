# .env.example
# Django
DJANGO_SECRET_KEY='django-insecure-dev-key-change-in-production'
DEBUG=True
READ_DOT_ENV_FILE=True

# PostgreSQL (base applicative)
DB_NAME=pnsq_db
DB_USER=pnsq_user
DB_PASSWORD=pnsq_password
DB_HOST=localhost
DB_PORT=5432

# Oracle (base météo - READ-ONLY)
ORACLE_DB_SERVICE=ORCL_ANAM
ORACLE_RO_USER=pnsq_ro
ORACLE_RO_PASSWORD=oracle_password
ORACLE_HOST=oracle.anam.ma
ORACLE_PORT=1521

# Redis (Cache)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0

# Celery
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0